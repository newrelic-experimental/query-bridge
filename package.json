{
  "name": "nr-query-bridge-workspaces",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace root for the nr-query-bridge translator and the dashboard importer.",
  "workspaces": [
    "packages/nr-query-bridge",
    "packages/nr-dashboard-importer"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "scripts": {
    "test": "npm run test --workspaces --if-present && vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types:check": "npm run types:check --workspaces --if-present",
    "build:parsers": "npm run build:parsers --workspace=@newrelic/query-bridge",
    "build:types": "npm run build:types --workspace=@newrelic/query-bridge",
    "scan:secrets": "scripts/scan-secrets.sh git",
    "scan:secrets:dir": "scripts/scan-secrets.sh dir",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "*",
    "@commitlint/config-conventional": "*",
    "@eslint/js": "*",
    "@vitest/coverage-v8": "*",
    "eslint": "*",
    "eslint-config-prettier": "*",
    "fast-check": "*",
    "husky": "*",
    "lint-staged": "*",
    "peggy": "*",
    "prettier": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "overrides": {
    "vite": ">=8.0.5",
    "postcss": ">=8.5.10"
  }
}
