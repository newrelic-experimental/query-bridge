/*
 * SPL (Search Processing Language) Grammar for PEG.js
 * ====================================================
 *
 * Parses SPL queries into an AST for translation to NRQL.
 *
 * Supports:
 * - Search clauses: field=value, bare keywords, quoted strings, wildcards
 * - Boolean operators: AND, OR, NOT (implicit AND between terms)
 * - Comparison operators: =, !=, >, >=, <, <=
 * - Time parameters: earliest=, latest=
 * - Metadata fields: index=, sourcetype=, source=, host=
 * - Parentheses grouping
 * - Backtick macros (parsed but not expanded)
 * - Pipe commands: stats, timechart, chart, where, table, fields, sort, head, top, rename
 * - Catch-all for unsupported commands
 *
 * AST node types:
 *   Pipeline { search, commands }
 *   BooleanOp { operator, left, right }
 *   Not { operand }
 *   Comparison { field, operator, value }
 *   BareKeyword { value, quoted }
 *   TimeConstraint { param, value }
 *   MetadataFilter { field, value }
 *   Macro { name, args }
 *   StatsCommand, TimechartCommand, ChartCommand, WhereCommand,
 *   TableCommand, FieldsCommand, SortCommand, HeadCommand,
 *   TopCommand, RenameCommand, UnsupportedCommand
 */

start
  = _* pipeline:pipeline _* { return pipeline; }

// Secondary start rule (build:parsers --allowed-start-rules): one pipe command
// parsed WITHOUT the unknown_command catch-all. When a known command's own rule
// fails, `start` still succeeds via unknown_command; re-parsing the stage here
// recovers the parser's position/expectation so the caller can report the exact
// construct that failed instead of "no known NRQL equivalent".
strict_command
  = _* cmd:known_command _* { return cmd; }

known_command
  = stats_command
  / timechart_command
  / chart_command
  / where_command
  / search_pipe_command
  / table_command
  / fields_command
  / sort_command
  / head_command
  / tail_command
  / top_command
  / rename_command
  / dedup_command
  / eval_command
  / rex_command
  / bin_command
  / lookup_command
  / inputlookup_command
  / spath_command
  / join_command
  / regex_command
  / fillnull_command
  / rare_command
  / reverse_command
  / strcat_command
  / uniq_command
  / convert_command
  / appendcols_command
  / appendpipe_command
  / append_command
  / eventstats_command
  / mvexpand_command
  / replace_command
  / predict_command
  / tstats_command

pipeline
  = search:search_clause? pipes:pipe_command* _* '|'* _*
    {
      return {
        type: 'Pipeline',
        search: search || null,
        commands: pipes
      };
    }

pipe_command
  = _* '|'+ _* cmd:command { return cmd; }

command
  = stats_command
  / timechart_command
  / chart_command
  / where_command
  / search_pipe_command
  / table_command
  / fields_command
  / sort_command
  / head_command
  / tail_command
  / top_command
  / rename_command
  / dedup_command
  / eval_command
  / rex_command
  / bin_command
  / lookup_command
  / inputlookup_command
  / spath_command
  / join_command
  / regex_command
  / fillnull_command
  / rare_command
  / reverse_command
  / strcat_command
  / uniq_command
  / convert_command
  / appendcols_command
  / appendpipe_command
  / append_command
  / eventstats_command
  / mvexpand_command
  / replace_command
  / predict_command
  / tstats_command
  / macro_command
  / unknown_command

/* ============================================================
   Stats command: | stats fn() [as alias] [, fn() [as alias]]... [by field, ...]
   ============================================================ */
stats_command
  = 'stats'i _+ fns:stats_function_list by:by_clause?
    {
      return {
        type: 'StatsCommand',
        functions: fns,
        groupBy: by || []
      };
    }

stats_function_list
  // A stray trailing comma before the by-clause is tolerated (`stats count, by h`).
  = first:stats_function rest:(stats_function_separator fn:stats_function { return fn; })* (_* ',')?
    {
      return [first].concat(rest);
    }

stats_function_separator
  = _* ',' _*
  / _+ !('by'i _+ / 'BY' _+)

stats_function
  = _* name:function_name '(' _* 'eval'i _* '(' _* evalExpr:u_expr _* ')' _* ')' alias:as_clause?
    {
      return { name: name, args: [], alias: alias, evalFilter: evalExpr };
    }
  / _* name:function_name '(' _* args:function_args _* ')' alias:as_clause?
    {
      return { name: name, args: args, alias: alias };
    }
  / _* ('count'i / 'c'i !([a-zA-Z0-9_])) alias:as_clause?
    {
      return { name: 'count', args: [], alias: alias };
    }

// A function name; a fractional percentile (`perc99.9`, `p99.9`) keeps its
// decimal part so it maps to percentile(x, 99.9).
function_name
  = chars:$([a-zA-Z_0-9]+ ('.' [0-9]+ &'(')?) { return chars.toLowerCase(); }

function_args
  = first:u_expr rest:(',' _* arg:u_expr { return arg; })*
    { return [first].concat(rest); }
  / '' { return []; }

as_clause
  = _+ 'as'i _+ '"' alias:double_string_char* '"' { return alias.join(''); }
  / _+ 'as'i _+ "'" alias:single_string_char* "'" { return alias.join(''); }
  / _+ 'as'i _+ alias:field_name { return alias; }

by_clause
  = _+ 'by'i _+ fields:by_field_list { return fields; }

by_field_list
  = first:by_field_item rest:((_* ',' _* / _+) name:by_field_item { return name; })*
    { return [first].concat(rest); }

// A by-field is a field name NOT immediately followed by '=' (which would make it
// a command option like limit=N / useother=false, not a grouping field).
by_field_item
  = name:quotable_field_name !(_* '=') { return name; }

field_list
  = (',' _*)? first:list_field_name rest:((_* ',' _* / _+) name:list_field_name { return name; })* (_* ',')?
    { return [first].concat(rest); }

// A field in a table/fields/dedup list: a quoted name, a stats output column
// written as its function call (`max(b)` — the column an unaliased `stats max(b)`
// produces), or a bare name that may carry `*` wildcards (`Totals*`). Handlers
// decide what each form can translate to.
list_field_name
  = quotable_field_name_nonwild
  / call:$([a-zA-Z_][a-zA-Z0-9_]* '(' [^()|]* ')') { return call; }
  / chars:$([a-zA-Z0-9_.\-:{}*]+) { return chars; }

quotable_field_name_nonwild
  = '"' chars:double_string_char* '"' { return chars.join(''); }
  / chars:$([a-zA-Z0-9_.\-:{}]+) ![*(] { return chars; }
  / '*' ![a-zA-Z0-9_.\-:{}*(] { return '*'; }

field_name
  = '*' { return '*'; }
  / chars:[a-zA-Z0-9_.\-:{}]+ { return chars.join(''); }

// A field name that may be double-quoted — Splunk allows quoting field names that
// contain spaces or other special chars (`table "Full message"`, `stats count by
// "Container Name"`). Used only in list/by contexts where a quote means a field
// name, NOT in eval/where/search contexts where a quote means a string literal.
// Returns the inner text; the emitter backticks names that need it.
quotable_field_name
  = '"' chars:double_string_char* '"' { return chars.join(''); }
  / field_name

/* ============================================================
   Timechart command: | timechart [span=X] fn() [by field]
   ============================================================ */
// Options (span=, limit=, bins=, cont=, …) are accepted in ANY position: before the
// functions, between the functions and the by-clause, or after it. Each is parsed
// once by the shared cmd_option rule; handleTimechart interprets them.
timechart_command
  = 'timechart'i lead:cmd_option* _+ fns:stats_function_list midItems:(o:cmd_option { return { opt: o }; } / a:as_clause { return { alias: a }; })* by:by_clause? tail:cmd_option*
    {
      // A trailing `as X` (possibly after an option: `count(x) span=5m as X`)
      // names the last function.
      var mid = [];
      for (var j = 0; j < midItems.length; j++) {
        if (midItems[j].opt) mid.push(midItems[j].opt);
        else if (fns.length > 0 && !fns[fns.length - 1].alias) fns[fns.length - 1].alias = midItems[j].alias;
      }
      var opts = lead.concat(mid, tail);
      var span = null;
      var options = [];
      for (var i = 0; i < opts.length; i++) {
        var o = opts[i];
        if (o.key === 'span') {
          var tok = /^\$([a-zA-Z0-9_.:-]+)\$$/.exec(o.value);
          span = tok ? { type: 'SpanToken', name: tok[1] } : o.value;
        } else if (o.key === 'limit' && /^[0-9]+$/.test(o.value)) {
          options.push({ type: 'limit', value: parseInt(o.value, 10) });
        } else {
          options.push({ type: o.key, value: o.value });
        }
      }
      return {
        type: 'TimechartCommand',
        span: span,
        functions: fns,
        groupBy: by || [],
        options: options
      };
    }

// A `key=value` command option, shared by every command whose options may appear
// in any position. The key must be immediately followed by '=' so a field or
// function name is never mistaken for an option. Returns { key, value } with the
// key lower-cased and the value unquoted.
cmd_option
  = _+ key:$([a-zA-Z_]+) '=' value:cmd_option_value
    { return { key: key.toLowerCase(), value: value }; }

cmd_option_value
  = '"' chars:double_string_char* '"' { return chars.join(''); }
  / "'" chars:single_string_char* "'" { return chars.join(''); }
  / chars:$([^ \t\r\n\f|,()]+) { return chars; }

span_clause
  = 'span=' value:span_value _+
    { return value; }

span_value
  = '$' name:template_var_name '$'
    { return { type: 'SpanToken', name: name }; }
  / num:[0-9]+ unit:[smhdwMy]
    { return num.join('') + unit; }
  / 'day'i { return '1d'; }
  / 'hour'i { return '1h'; }
  / 'minute'i { return '1m'; }
  / 'month'i { return '1M'; }
  / 'week'i { return '1w'; }

/* ============================================================
   Chart command: | chart fn() [by field] [over field]
   ============================================================ */
// `over` and `by` may appear in either order (`chart f over X by Y` is the
// canonical form); options may appear anywhere. Group-by fields keep the order
// written.
chart_command
  = 'chart'i lead:cmd_option* _+ fns:stats_function_list mid:cmd_option* clauses:(c:(by_clause / over_clause) o:cmd_option* { return { fields: c, opts: o }; })*
    {
      var groupBy = [];
      var opts = lead.concat(mid);
      for (var i = 0; i < clauses.length; i++) {
        groupBy = groupBy.concat(clauses[i].fields);
        opts = opts.concat(clauses[i].opts);
      }
      return {
        type: 'ChartCommand',
        functions: fns,
        groupBy: groupBy,
        options: opts.map(function (o) { return { type: o.key, value: o.value }; })
      };
    }

over_clause
  = _+ 'over'i _+ field:quotable_field_name !(_* '=') { return [field]; }

/* ============================================================
   Where command: | where <expression>
   ============================================================ */
where_command
  // `where(expr)` with no space before the paren is valid SPL — require the next
  // char to be whitespace or '(' so `wherefoo` doesn't parse as `where foo`.
  = 'where'i &(_ / '(') _* expr:where_expression
    {
      return {
        type: 'WhereCommand',
        expression: expr
      };
    }

where_expression
  = left:where_or_expr { return left; }

where_or_expr
  = left:where_and_expr rest:(_+ 'OR'i _+ right:where_and_expr { return right; })*
    {
      var result = left;
      for (var i = 0; i < rest.length; i++) {
        result = { type: 'BooleanOp', operator: 'OR', left: result, right: rest[i] };
      }
      return result;
    }

where_and_expr
  = left:where_not_expr rest:(_+ 'AND'i _+ right:where_not_expr { return right; })*
    {
      var result = left;
      for (var i = 0; i < rest.length; i++) {
        result = { type: 'BooleanOp', operator: 'AND', left: result, right: rest[i] };
      }
      return result;
    }

where_not_expr
  = 'NOT'i _+ expr:where_primary { return { type: 'Not', operand: expr }; }
  // `!` as NOT — only before '(' or whitespace, never before '=' (that is the
  // `!=` comparison operator, handled inside where_comparison).
  / '!' &('(' / _) _* expr:where_primary { return { type: 'Not', operand: expr }; }
  / where_primary

where_primary
  = '(' _* expr:where_expression _* ')' { return expr; }
  / where_const_comparison
  / where_in_comparison
  / where_func_comparison
  / where_function_call
  / where_comparison

// Literal-vs-literal comparison — the dashboard all-token guard idiom
// `where "$tok$"="*" OR f="$tok$"`. Constant-folded in translateSearchExpr; it is
// never emitted as NRQL. Each side must be a double-quoted string or a number
// that is not the start of a longer expression. (In where/eval a single-quoted
// token is a FIELD name, and a bare word is a field — neither is a constant.)
where_const_comparison
  = left:where_const_literal _* op:('==' / '!=' / '=') _* right:where_const_literal !(_* [+\-*/%.])
    { return { type: 'ConstComparison', left: left, operator: op, right: right }; }

where_const_literal
  = '"' chars:double_string_char* '"' { return { kind: 'string', value: chars.join('') }; }
  / n:$('-'? [0-9]+ ('.' [0-9]+)?) ![a-zA-Z0-9_.] { return { kind: 'number', value: n }; }

// `where f IN ("a","b")` / `where f in (1, 2)` — NRQL has a direct IN.
where_in_comparison
  = field:field_name _+ 'IN'i _* '(' _* values:in_value_list _* ')'
    { return { type: 'InComparison', field: field, values: values }; }

where_function_call
  = name:function_name _* '(' _* args:function_args _* ')'
    {
      return { type: 'FunctionCall', name: name, args: args };
    }

// A function call on the LEFT of a comparison: mvcount(f) > 1, len(x) >= 3, etc.
where_func_comparison
  = fn:where_function_call _* op:comparison_op _* value:where_value
    {
      return { type: 'FuncComparison', left: fn, operator: op, value: value };
    }

where_comparison
  = field:field_name _+ 'like'i _+ value:where_value
    {
      return { type: 'Comparison', field: field, operator: 'like', value: value };
    }
  / field:field_name _* op:comparison_op _* rhs:u_add
    &{
      // Route through rhsExpr ONLY for non-literal RHS (field/func/arith/parens).
      // A lone number string or a lone StringLiteral must backtrack to where_value
      // so existing literal-RHS cases keep their legacy translation untouched.
      if (rhs && typeof rhs === 'object' && rhs.type === 'StringLiteral') return false;
      if (typeof rhs === 'string' && /^[0-9]/.test(rhs)) return false;
      return true;
    }
    {
      return { type: 'Comparison', field: field, operator: op, rhsExpr: rhs };
    }
  / field:field_name _* op:comparison_op _* value:where_value
    {
      return { type: 'Comparison', field: field, operator: op, value: value };
    }

where_value
  = '"' chars:double_string_char* '"' { return chars.join(''); }
  / "'" chars:single_string_char* "'" { return chars.join(''); }
  / chars:[^ \t\r\n\f|(),"']+ { return chars.join(''); }

/* ============================================================
   Search pipe command: | search <expression>
   (Same as search clause but used as a pipe command)
   ============================================================ */
search_pipe_command
  = 'search'i _+ expr:or_expr
    {
      return {
        type: 'SearchCommand',
        expression: expr
      };
    }

/* ============================================================
   Table command: | table field1, field2, ...
   ============================================================ */
table_command
  = 'table'i &(_ / ',') _* fields:field_list
    {
      return {
        type: 'TableCommand',
        fields: fields
      };
    }

/* ============================================================
   Fields command: | fields [+|-] field1, field2, ...
   ============================================================ */
fields_command
  = 'fields'i _+ mode:[+-]? _* fields:field_list
    {
      return {
        type: 'FieldsCommand',
        mode: mode || '+',
        fields: fields
      };
    }

/* ============================================================
   Sort command: | sort [-|+]field, ...
   ============================================================ */
sort_command
  = 'sort'i _+ limit:sort_limit? fields:sort_field_list trailingLimit:sort_trailing_limit?
    {
      return {
        type: 'SortCommand',
        fields: fields,
        limit: trailingLimit !== null && trailingLimit !== undefined ? trailingLimit : limit
      };
    }

sort_limit
  = n:[0-9]+ _+
    { return parseInt(n.join(''), 10); }
  / 'limit'i '=' n:[0-9]+ _+
    { return parseInt(n.join(''), 10); }

// SPL also allows a trailing `limit=N` after the sort fields.
sort_trailing_limit
  = _* 'limit'i '=' n:[0-9]+
    { return parseInt(n.join(''), 10); }

// Sort keys are separated by commas OR whitespace. A whitespace-separated key
// must not be a `limit=` option (handled by sort_trailing_limit).
sort_field_list
  = first:sort_field rest:((_* ',' _* / _+) f:sort_field { return f; })*
    { return [first].concat(rest); }

sort_field
  = _* dir:[-+]? _* name:sort_field_name order:sort_order?
    {
      var direction = 'asc';
      if (dir === '-') direction = 'desc';
      if (order) direction = order;
      return {
        field: name,
        direction: direction
      };
    }

// A sort field may be wrapped in a type-hint: num(f) / str(f) / ip(f).
// The hint only tells Splunk how to compare; NRQL ignores it, so we keep the
// bare field name. A bare field must not be `limit=...` (a trailing option).
sort_field_name
  = ('num'i / 'str'i / 'ip'i) '(' _* name:quotable_field_name _* ')' { return name; }
  / !('limit'i '=') name:quotable_field_name { return name; }

sort_order
  = _+ 'desc'i { return 'desc'; }
  / _+ 'asc'i { return 'asc'; }

/* ============================================================
   Head command: | head [N]
   ============================================================ */
head_command
  = 'head'i count:(_+ n:[0-9]+ { return parseInt(n.join(''), 10); })?
    {
      return {
        type: 'HeadCommand',
        count: count !== null ? count : 10
      };
    }

/* ============================================================
   Tail command: | tail [N]
   ============================================================ */
tail_command
  = 'tail'i count:(_+ n:[0-9]+ { return parseInt(n.join(''), 10); })?
    {
      return {
        type: 'TailCommand',
        count: count !== null ? count : 10
      };
    }

/* ============================================================
   Top command: | top [N | limit=N] [options] field [by field, ...]
   Options: limit=N, countfield=X, useother=bool, showperc=bool, showcount=bool
   ============================================================ */
top_command
  = 'top'i _+ opts:top_options fields:top_field_list limit:(_+ 'limit'i '=' n:[0-9]+ { return parseInt(n.join(''), 10); })? by:by_clause?
    {
      return {
        type: 'TopCommand',
        count: opts.limit !== null ? opts.limit : (limit !== null && limit !== undefined ? limit : 10),
        fields: fields,
        groupBy: by || [],
        countfield: opts.countfield || null,
        percentfield: opts.percentfield || null,
        useother: opts.useother || false,
        showperc: opts.showperc !== null ? opts.showperc : true
      };
    }

// Comma- or space-separated top fields. A field must not be the `by` keyword
// (which begins the by-clause) and must not be immediately followed by '='
// (which would make it a trailing option like limit=N).
top_field_list
  = first:top_field_item rest:((_* ',' _* / _+) name:top_field_item { return name; })*
    { return [first].concat(rest); }

top_field_item
  = !('by'i _) name:quotable_field_name !(_* '=') { return name; }

top_options
  = items:top_option*
    {
      var result = { limit: null, countfield: null, percentfield: null, useother: false, showperc: null };
      for (var i = 0; i < items.length; i++) {
        var item = items[i];
        if (item.type === 'limit') result.limit = item.value;
        else if (item.type === 'countfield') result.countfield = item.value;
        else if (item.type === 'percentfield') result.percentfield = item.value;
        else if (item.type === 'useother') result.useother = item.value;
        else if (item.type === 'showperc') result.showperc = item.value;
      }
      return result;
    }

top_option
  = n:[0-9]+ _+
    { return { type: 'limit', value: parseInt(n.join(''), 10) }; }
  / 'limit'i '=' n:[0-9]+ _+
    { return { type: 'limit', value: parseInt(n.join(''), 10) }; }
  / 'countfield'i '=' val:option_value _+
    { return { type: 'countfield', value: val }; }
  / 'useother'i '=' val:bool_value _+
    { return { type: 'useother', value: val }; }
  / 'showperc'i '=' val:bool_value _+
    { return { type: 'showperc', value: val }; }
  / 'showcount'i '=' val:bool_value _+
    { return { type: 'showperc', value: val }; }
  / 'percentfield'i '=' val:option_value _+
    { return { type: 'percentfield', value: val }; }

option_value
  = chars:[a-zA-Z0-9_]+ { return chars.join(''); }

bool_value
  = 'true'i  { return true; }
  / 'false'i { return false; }
  / 't'i     { return true; }
  / 'f'i     { return false; }

/* ============================================================
   Rename command: | rename old AS new [, old AS new ...]
   ============================================================ */
rename_command
  = 'rename'i _+ renames:rename_list
    {
      return {
        type: 'RenameCommand',
        renames: renames
      };
    }

rename_list
  = first:rename_pair rest:((_* ',' _* / _+) pair:rename_pair { return pair; })*
    { return [first].concat(rest); }

rename_pair
  = from:rename_field _+ 'as'i _+ to:rename_field
    { return { from: from, to: to }; }

rename_field
  = '"' chars:double_string_char* '"' { return chars.join(''); }
  / "'" chars:single_string_char* "'" { return chars.join(''); }
  / chars:[a-zA-Z0-9_.\-:{}*]+ { return chars.join(''); }

/* ============================================================
   Dedup command: | dedup field1, field2, ...
   ============================================================ */
// `dedup N f1 f2` keeps the first N events per combination; N defaults to 1. The
// count is only recognized when it is followed by a field, so it is never
// mistaken for a field name.
dedup_command
  = 'dedup'i _+ count:(n:$([0-9]+) _+ &list_field_name { return parseInt(n, 10); })? fields:field_list
    {
      return {
        type: 'DedupCommand',
        count: count === null ? 1 : count,
        fields: fields
      };
    }

/* ============================================================
   Eval command: | eval field=expr [, field=expr ...]
   Parses simple arithmetic assignments. Falls back to rawText
   for anything it can't parse (function calls, conditionals, etc.)
   ============================================================ */
eval_command
  = 'eval'i _+ first:eval_assignment rest:(_* ',' _* a:eval_assignment { return a; })* &(_* '|' / _* !.)
    {
      return {
        type: 'EvalCommand',
        assignments: [first].concat(rest),
        rawText: null
      };
    }
  / 'eval'i _+ rest:rest_of_command
    {
      return {
        type: 'EvalCommand',
        assignments: [],
        rawText: rest
      };
    }

eval_assignment
  = field:field_name _* '=' _* expr:u_expr
    { return { field: field, expr: expr }; }

eval_string_literal
  = '"' chars:double_string_char* '"' { return { type: 'StringLiteral', value: chars.join('') }; }
  / "'" chars:single_string_char* "'" { return { type: 'StringLiteral', value: chars.join('') }; }

eval_number
  = digits:[0-9]+ frac:('.' d:[0-9]+ { return '.' + d.join(''); })?
    { return digits.join('') + (frac || ''); }

/* ============================================================
   Unified eval expression ladder. ONE definition of the SPL eval
   expression language, referenced by all four call sites. Precedence,
   tight→loose: parens, unary(-/NOT), * / %, + - ., comparison, AND, OR.
   Peek-and-extend at every level to avoid O(3^n) backtracking. The only
   per-context divergence is u_atom (base field atom vs. stats-wildcard atom).
   ============================================================ */
u_expr
  = u_or

u_or
  = head:u_and tail:(_* 'OR'i _* r:u_and { return r; })*
    {
      var result = head;
      for (var i = 0; i < tail.length; i++) {
        result = { type: 'EvalBoolOp', op: 'OR', left: result, right: tail[i] };
      }
      return result;
    }

u_and
  = head:u_not tail:(_* 'AND'i _* r:u_not { return r; })*
    {
      var result = head;
      for (var i = 0; i < tail.length; i++) {
        result = { type: 'EvalBoolOp', op: 'AND', left: result, right: tail[i] };
      }
      return result;
    }

u_not
  = 'NOT'i _+ operand:u_not { return { type: 'EvalNot', operand: operand }; }
  / u_cmp

u_cmp
  = left:u_add tail:(_* op:comparison_op _* right:u_add { return { op: op, right: right }; })?
    {
      return tail
        ? { type: 'EvalComparison', op: tail.op, left: left, right: tail.right }
        : left;
    }

u_add
  = head:u_mul tail:(_* op:[+\-.] _* r:u_mul { return { op: op, right: r }; })*
    {
      var result = head;
      for (var i = 0; i < tail.length; i++) {
        result = { type: 'EvalArith', op: tail[i].op, left: result, right: tail[i].right };
      }
      return result;
    }

u_mul
  = head:u_unary tail:(_* op:[*/%] _* r:u_unary { return { op: op, right: r }; })*
    {
      var result = head;
      for (var i = 0; i < tail.length; i++) {
        result = { type: 'EvalArith', op: tail[i].op, left: result, right: tail[i].right };
      }
      return result;
    }

u_unary
  = '-' _* operand:u_unary { return { type: 'EvalArith', op: '-', left: '0', right: operand }; }
  / u_atom

u_atom
  = u_atom_stats_extra
  / u_atom_base

u_atom_base
  = '(' _* e:u_expr _* ')' { return { type: 'EvalParens', inner: e }; }
  / u_func_call
  / eval_string_literal
  / n:eval_number ![a-zA-Z_] { return n; }
  / f:eval_field_name { return f; }

// A field reference inside an expression. Same charset as field_name, except a
// '.' directly followed by a quote is the `.` concat operator, not part of the
// name: `a.":".b` is concat(a, ':', b), not a field named `a.`.
eval_field_name
  = '*' { return '*'; }
  / chars:$(([a-zA-Z0-9_\-:{}] / '.' !(_* ["'])))+ { return chars; }

u_atom_stats_extra
  = chars:[a-zA-Z0-9_.:{}]* '*' ![0-9] rest:[a-zA-Z0-9_.:{}*]*
    { return (chars.join('') + '*' + rest.join('')); }

u_func_call
  = name:function_name _* '(' _* args:u_func_args _* ')'
    { return { type: 'EvalFunc', name: name, args: args }; }

u_func_args
  = first:u_expr rest:(_* ',' _* a:u_expr { return a; })*
    { return [first].concat(rest); }
  / '' { return []; }

/* ============================================================
   Rex command: | rex [field=F] "regex" or | rex mode=sed "expr"
   ============================================================ */
// Options (field=, mode=, max_match=, offset_field=) may appear before or after
// the regex, in any order. The regex is normally quoted; an UNQUOTED regex is
// accepted too (exported dashboards often lose the outer quotes and keep `\"`
// escapes, e.g. rex \"k\"\:\"(?<v>.+?)\"). An unquoted regex may not start with
// a quote — `"…"\"` is malformed input, not a regex.
rex_command
  = 'rex'i lead:rex_option* _+ pattern:rex_pattern trail:rex_option* &(_* '|' / _* !.)
    {
      var opts = lead.concat(trail);
      var field = '_raw', mode = 'extract', maxMatch = null;
      for (var i = 0; i < opts.length; i++) {
        if (opts[i].key === 'field') field = opts[i].value;
        else if (opts[i].key === 'mode') mode = opts[i].value.toLowerCase();
        else if (opts[i].key === 'max_match') maxMatch = parseInt(opts[i].value, 10);
      }
      return {
        type: 'RexCommand',
        mode: mode,
        field: field,
        pattern: pattern,
        maxMatch: maxMatch,
        rawText: null
      };
    }
  / 'rex'i _+ rest:rest_of_command
    {
      return {
        type: 'RexCommand',
        mode: 'unknown',
        field: null,
        pattern: null,
        rawText: rest
      };
    }

rex_option
  = _+ key:$('field'i / 'mode'i / 'max_match'i / 'offset_field'i) '=' value:rex_option_value
    { return { key: key.toLowerCase(), value: value }; }

rex_option_value
  = '"' chars:double_string_char* '"' { return chars.join(''); }
  / chars:$([^ \t\r\n\f|"]+) { return chars; }

rex_pattern
  = '"' pattern:rex_string_char* '"' { return pattern.join(''); }
  / !'"' !(('field'i / 'mode'i / 'max_match'i / 'offset_field'i) '=') chars:$([^ \t\r\n\f|]+) { return chars; }

/* Regex string chars: preserves backslash sequences (unlike double_string_char which interprets them) */
rex_string_char
  = '\\' ch:. { return '\\' + ch; }
  / [^"\\]

/* ============================================================
   Bin command: | bin _time span=X
   ============================================================ */
bin_command
  = ('bin'i / 'bucket'i) _+ '_time' _+ 'span=' span:span_value
    {
      return {
        type: 'BinCommand',
        field: '_time',
        span: span,
        rawText: '_time span=' + span
      };
    }
  / ('bin'i / 'bucket'i) _+ 'span=' span:span_value _+ field:field_name alias:as_clause?
    {
      var isToken = span !== null && typeof span === 'object';
      return {
        type: 'BinCommand',
        field: field,
        // A SpanToken object is preserved on span so handleBin's token guard
        // catches it for any field; only a literal span becomes a numeric width.
        span: field === '_time' || isToken ? span : null,
        width: field !== '_time' && !isToken ? parseInt(span, 10) || null : null,
        alias: alias || null,
        rawText: 'span=' + (isToken ? '$' + span.name + '$' : span) + ' ' + field
      };
    }
  / ('bin'i / 'bucket'i) _+ field:field_name _+ 'span=' '$' name:template_var_name '$' alias:as_clause?
    {
      // A dashboard span token after the field (`bin field span=$tok$`). Preserve
      // the SpanToken object on span so handleBin's token guard surfaces the
      // specific span_token_unsupported regardless of field/span order.
      return {
        type: 'BinCommand',
        field: field,
        span: { type: 'SpanToken', name: name },
        width: null,
        alias: alias || null,
        rawText: field + ' span=$' + name + '$'
      };
    }
  / ('bin'i / 'bucket'i) _+ field:field_name _+ 'span=' width:[0-9]+ alias:as_clause?
    {
      return {
        type: 'BinCommand',
        field: field,
        span: null,
        width: parseInt(width.join(''), 10),
        alias: alias || null,
        rawText: field + ' span=' + width.join('')
      };
    }
  / ('bin'i / 'bucket'i) _+ rest:rest_of_command
    {
      return {
        type: 'BinCommand',
        field: null,
        span: null,
        rawText: rest
      };
    }

/* ============================================================
   Lookup command: | lookup tableName keyField [OUTPUT field1, field2, ...]
   ============================================================ */
lookup_command
  = 'lookup'i _+ table:field_name _+ key:field_name alias:as_clause? output:lookup_output?
    {
      return {
        type: 'LookupCommand',
        table: table,
        key: key,
        keyAlias: alias || null,
        outputFields: output || []
      };
    }

lookup_output_field
  = name:field_name alias:as_clause? { return { name: name, alias: alias || null }; }

lookup_output_field_list
  = first:lookup_output_field rest:((_* ',' _* / _+) f:lookup_output_field { return f; })*
    { return [first].concat(rest); }

lookup_output
  = _+ 'OUTPUT'i _+ fields:lookup_output_field_list
    { return fields; }
  / _+ 'OUTPUTNEW'i _+ fields:lookup_output_field_list
    { return fields; }

/* ============================================================
   Inputlookup command: | inputlookup [append=true] tablename
   ============================================================ */
inputlookup_command
  = 'inputlookup'i _+ 'append='i [a-zA-Z]+ _+ table:field_name _+ 'where'i _+ condition:where_expression
    {
      return { type: 'InputlookupCommand', table: table, append: true, where: condition };
    }
  / 'inputlookup'i _+ table:field_name _+ 'where'i _+ condition:where_expression
    {
      return { type: 'InputlookupCommand', table: table, append: false, where: condition };
    }
  / 'inputlookup'i _+ 'append='i [a-zA-Z]+ _+ table:field_name
    {
      return { type: 'InputlookupCommand', table: table, append: true };
    }
  / 'inputlookup'i _+ table:field_name
    {
      return { type: 'InputlookupCommand', table: table, append: false };
    }

/* ============================================================
   Join command: | join [type=inner|left|outer] field [subsearch]
   ============================================================ */
join_command
  = 'join'i jtype:join_type_option? _+ first:field_name rest:((_* ',' _* / _+) f:field_name { return f; })* _* '[' subsearch:subsearch_content ']'
    {
      return {
        type: 'JoinCommand',
        joinType: jtype || 'inner',
        field: first,
        fields: [first].concat(rest),
        subsearch: subsearch
      };
    }

join_type_option
  = _+ 'type=' type:('inner'i / 'left'i / 'outer'i) { return type.toLowerCase(); }

subsearch_content
  = chars:subsearch_char+ { return chars.join(''); }

subsearch_char
  = '[' inner:subsearch_content ']' { return '[' + inner + ']'; }
  / ch:[^\[\]] { return ch; }

/* ============================================================
   Spath command: | spath [input=field] [path=json.path] [output=alias]
   ============================================================ */
spath_command
  = 'spath'i opts:spath_option* pos:spath_positional?
    {
      var input = null, path = null, output = null;
      for (var i = 0; i < opts.length; i++) {
        if (opts[i].key === 'input') input = opts[i].value;
        if (opts[i].key === 'path') path = opts[i].value;
        if (opts[i].key === 'output') output = opts[i].value;
      }
      if (pos && !path) path = pos;
      return {
        type: 'SpathCommand',
        input: input,
        path: path,
        output: output
      };
    }

spath_option
  = _+ key:('input'i / 'path'i / 'output'i) '=' value:spath_option_value
    { return { key: key.toLowerCase(), value: value }; }

// A path may mix bare and quoted segments: path=body."Some Name{}".id — each
// quoted piece contributes its unquoted text.
spath_option_value
  = parts:('"' chars:double_string_char* '"' { return chars.join(''); }
          / "'" chars:single_string_char* "'" { return chars.join(''); }
          / chars:$([^ \t\r\n\f|"']+) { return chars; })+
    { return parts.join(''); }

spath_positional
  = _+ '"' chars:double_string_char* '"' { return chars.join(''); }
  / _+ "'" chars:single_string_char* "'" { return chars.join(''); }
  / _+ !('input'i '=' / 'path'i '=' / 'output'i '=') chars:[^ \t\r\n\f|]+ { return chars.join(''); }

/* ============================================================
   Regex command: | regex [field=F] "pattern" or | regex field!=pattern
   ============================================================ */
regex_command
  = 'regex'i _+ field:field_name '=' '"' pattern:rex_string_char* '"'
    {
      return {
        type: 'RegexCommand',
        field: field,
        negate: false,
        pattern: pattern.join('')
      };
    }
  / 'regex'i _+ field:field_name '!=' '"' pattern:rex_string_char* '"'
    {
      return {
        type: 'RegexCommand',
        field: field,
        negate: true,
        pattern: pattern.join('')
      };
    }
  / 'regex'i _+ '"' pattern:rex_string_char* '"'
    {
      return {
        type: 'RegexCommand',
        field: '_raw',
        negate: false,
        pattern: pattern.join('')
      };
    }
  / 'regex'i _+ rest:rest_of_command
    {
      return {
        type: 'RegexCommand',
        field: null,
        negate: false,
        pattern: null,
        rawText: rest
      };
    }

/* ============================================================
   Fillnull command: | fillnull [value=X] [field1 field2 ...]
   ============================================================ */
// value= may come before, between, or after the field list.
fillnull_command
  = 'fillnull'i items:(v:fillnull_value { return { value: v }; } / (_* ',' _* / _+) f:field_name !'=' { return { field: f }; })*
    {
      var val = null, fields = [];
      for (var i = 0; i < items.length; i++) {
        if ('value' in items[i]) val = items[i].value;
        else fields.push(items[i].field);
      }
      return {
        type: 'FillnullCommand',
        value: val,
        fields: fields
      };
    }

fillnull_value
  = _+ 'value=' '"' chars:double_string_char* '"' { return chars.join(''); }
  / _+ 'value=' "'" chars:single_string_char* "'" { return chars.join(''); }
  / _+ 'value=' chars:[^ \t\r\n\f|]+ { return chars.join(''); }

/* ============================================================
   Rare command: | rare [N] field [by field, ...]
   ============================================================ */
rare_command
  = 'rare'i _+ opts:rare_options fields:rare_field_list limit:(_+ 'limit=' n:[0-9]+ { return parseInt(n.join(''), 10); })? by:by_clause?
    {
      var effectiveLimit = opts.limit || limit || 10;
      return {
        type: 'RareCommand',
        count: effectiveLimit,
        field: fields[0],
        groupBy: fields.slice(1).concat(by || [])
      };
    }

rare_options
  = items:rare_option*
    {
      var result = { limit: null };
      for (var i = 0; i < items.length; i++) {
        if (items[i].type === 'limit') result.limit = items[i].value;
      }
      return result;
    }

rare_option
  = n:[0-9]+ _+
    { return { type: 'limit', value: parseInt(n.join(''), 10) }; }
  / 'limit'i '=' n:[0-9]+ _+
    { return { type: 'limit', value: parseInt(n.join(''), 10) }; }

rare_field_list
  = first:rare_field rest:(_+ !('by'i _+ / 'limit'i '=' / 'BY' _+) name:rare_field { return name; })*
    { return [first].concat(rest); }

rare_field
  = '"' chars:double_string_char* '"' { return chars.join(''); }
  / "'" chars:single_string_char* "'" { return chars.join(''); }
  / field_name

/* ============================================================
   Reverse command: | reverse
   ============================================================ */
reverse_command
  = 'reverse'i
    {
      return { type: 'ReverseCommand' };
    }

/* ============================================================
   Strcat command: | strcat field1 field2 ... destField
   ============================================================ */
strcat_command
  = 'strcat'i _+ parts:strcat_parts
    {
      return {
        type: 'StrcatCommand',
        parts: parts
      };
    }

strcat_parts
  = first:strcat_part rest:(_+ p:strcat_part { return p; })+
    { return [first].concat(rest); }

strcat_part
  = '"' chars:double_string_char* '"' { return { type: 'literal', value: chars.join('') }; }
  / "'" chars:single_string_char* "'" { return { type: 'literal', value: chars.join('') }; }
  / name:field_name { return { type: 'field', value: name }; }

/* ============================================================
   Uniq command: | uniq
   ============================================================ */
uniq_command
  = 'uniq'i
    {
      return { type: 'UniqCommand' };
    }

/* ============================================================
   Mvexpand command: | mvexpand field [limit=N]
   ============================================================ */
mvexpand_command
  = 'mvexpand'i _+ name:function_name '(' _* arg:field_name _* ')' limit:(_+ 'limit=' n:[0-9]+ { return parseInt(n.join(''), 10); })?
    {
      return { type: 'MvexpandCommand', field: name + '(' + arg + ')', limit: limit };
    }
  / 'mvexpand'i _+ field:field_name limit:(_+ 'limit=' n:[0-9]+ { return parseInt(n.join(''), 10); })?
    {
      return { type: 'MvexpandCommand', field: field, limit: limit };
    }

/* ============================================================
   Replace command: | replace "old" WITH "new" [, "old2" WITH "new2" ...] IN field
   ============================================================ */
replace_command
  = 'replace'i _+ pairs:replace_pair_list _+ 'IN'i _+ field:field_name
    {
      return {
        type: 'ReplaceCommand',
        pairs: pairs,
        oldValue: pairs[0].oldValue,
        newValue: pairs[0].newValue,
        field: field
      };
    }

replace_pair_list
  = first:replace_pair rest:(_* ',' _* p:replace_pair { return p; })*
    { return [first].concat(rest); }

replace_pair
  = '"' old:double_string_char* '"' _+ 'WITH'i _+ '"' new_val:double_string_char* '"'
    { return { oldValue: old.join(''), newValue: new_val.join('') }; }

/* ============================================================
   Predict command: | predict field [as alias] [algorithm=...]
   ============================================================ */
predict_command
  = 'predict'i _+ rest:rest_of_command
    {
      return {
        type: 'PredictCommand',
        rawText: rest
      };
    }

/* ============================================================
   Tstats command: | tstats ... FROM datamodel=X ...
   Parsed but not translated — emits actionable unsupported message.
   ============================================================ */
tstats_command
  = 'tstats'i _+ rest:rest_of_command
    {
      return {
        type: 'TstatsCommand',
        rawText: rest
      };
    }

/* ============================================================
   Append command: | append [subsearch]
   Only matches append followed by a bracketed subsearch.
   Bare "append" (no brackets) falls through to unknown_command.
   ============================================================ */
append_command
  = 'append'i _* '[' subsearch:subsearch_content ']'
    {
      return {
        type: 'AppendCommand',
        subsearch: subsearch
      };
    }

/* ============================================================
   Convert command: | convert func(field) [AS alias] [, func(field) [AS alias] ...]
   ============================================================ */
convert_command
  = 'convert'i _+ first:convert_spec rest:(_* ','? _* s:convert_spec { return s; })* &(_* '|' / _* !.)
    {
      return { type: 'ConvertCommand', specs: [first].concat(rest), rawText: null };
    }
  / 'convert'i _+ rest:rest_of_command
    {
      return { type: 'ConvertCommand', specs: [], rawText: rest };
    }

convert_spec
  = name:function_name '(' _* field:field_name _* ')' alias:as_clause?
    { return { name: name, field: field, alias: alias }; }

/* ============================================================
   Appendcols command: | appendcols [subsearch]
   Adds subsearch results as new columns. Same merge logic as append.
   ============================================================ */
appendcols_command
  = 'appendcols'i [^\[]* '[' subsearch:subsearch_content ']'
    {
      return {
        type: 'AppendcolsCommand',
        subsearch: subsearch
      };
    }

/* ============================================================
   Appendpipe command: | appendpipe [subpipeline]
   Runs a subpipeline and appends to current results.
   In practice, used for zero-fill fallbacks — a no-op for NRQL.
   ============================================================ */
appendpipe_command
  = 'appendpipe'i _* '[' subsearch:subsearch_content ']'
    {
      return {
        type: 'AppendpipeCommand',
        subsearch: subsearch
      };
    }

/* ============================================================
   Eventstats command: | eventstats fn() [as alias] [, ...] [by field, ...]
   Same syntax as stats but adds aggregated values to every row.
   ============================================================ */
eventstats_command
  = 'eventstats'i _+ fns:stats_function_list by:by_clause?
    {
      return {
        type: 'EventstatsCommand',
        functions: fns,
        groupBy: by || []
      };
    }

/* ============================================================
   Unknown/unsupported command catch-all
   ============================================================ */
unknown_command
  = name:command_name rest:(_+ r:rest_of_command { return r; })?
    {
      return {
        type: 'UnsupportedCommand',
        name: name,
        rawText: rest || ''
      };
    }

command_name
  = chars:[a-zA-Z]+ { return chars.join('').toLowerCase(); }

// Everything up to the next pipe. A `|` inside a quoted string is not a pipe; an
// unbalanced quote is kept as an ordinary character.
rest_of_command
  = chars:$(('"' double_string_char* '"' / "'" single_string_char* "'" / [^|])+) { return chars.trim(); }

/* ============================================================
   Search clause: boolean expressions of field=value, keywords, etc.
   ============================================================ */
search_clause
  = _* 'search'i _+ expr:or_expr { return expr; }
  / _* expr:or_expr { return expr; }

or_expr
  = left:and_expr rest:(_+ 'OR'i _+ right:and_expr { return right; })*
    {
      var result = left;
      for (var i = 0; i < rest.length; i++) {
        result = { type: 'BooleanOp', operator: 'OR', left: result, right: rest[i] };
      }
      return result;
    }

and_expr
  = left:not_expr rest:((_+ 'AND'i _+ / _+ !('OR'i _+) / delimiter_boundary) right:not_expr { return right; })*
    {
      var result = left;
      for (var i = 0; i < rest.length; i++) {
        result = { type: 'BooleanOp', operator: 'AND', left: result, right: rest[i] };
      }
      return result;
    }

// Splunk treats a self-closing delimiter (closing quote OR closing backtick of a
// macro) as an implicit term boundary, so the next term can be jammed against it
// with no whitespace: `!="*x*"field=y`, `index="z"$token$`, `` `macro`field=y ``.
// This zero-width separator is reachable only right after a delimiter-terminated
// term; gate it on the next token being a new search term (a comparison, a
// $token$, another quoted value, or a macro) so a single intended value is never
// split.
delimiter_boundary
  = &(search_field _* comparison_op / '$' template_var_name '$' / '"' / "'" / '`')

not_expr
  = 'NOT'i _* '(' _* ')' { return null; }
  / 'NOT'i _* '(' _* expr:or_expr _* ')' { return { type: 'Not', operand: expr }; }
  / 'NOT'i _+ '[' _* subsearch:[^\]]+ ']' { return { type: 'NotSubsearch', rawText: subsearch.join('') }; }
  / 'NOT'i _+ expr:not_expr { return { type: 'Not', operand: expr }; }
  / primary_expr

primary_expr
  = '(' _* expr:or_expr _* ')' { return expr; }
  / macro
  / time_constraint
  / in_comparison
  / comparison
  / term_directive
  / template_variable
  / top_level_subsearch
  / bare_keyword

// [subsearch] at the top level — Splunk runs the inner search and uses results as search terms
top_level_subsearch
  = '[' content:subsearch_content ']'
    { return { type: 'TopLevelSubsearch', rawText: content }; }

template_variable
  = '$' name:template_var_name '$'
    { return { type: 'TemplateVariable', name: name }; }

// Dashboard token/variable name charset. Hyphen and colon are included because
// all three cross-check SPL parsers (airbus-cert ANTLR, kotlaluk Lark from
// Splunk's btool BNF, salspaugh PLY) permit them mid-identifier, and a real
// corpus token `span=$time-span$` requires the hyphen. See
// .claude/references/spl-reference.md → Cross-check Parsers.
template_var_name
  = chars:[a-zA-Z0-9_.:-]+ { return chars.join(''); }

term_directive
  = 'TERM'i '(' '"' chars:double_string_char* '"' ')'
    { return { type: 'BareKeyword', value: chars.join('') }; }
  / 'TERM'i '(' chars:[^)]+ ')'
    { return { type: 'BareKeyword', value: chars.join('') }; }

macro_command
  = m:macro
    {
      return {
        type: 'MacroCommand',
        name: m.name,
        args: m.args
      };
    }

/* ============================================================
   Backtick macro: `macro_name` or `macro_name(arg1, arg2)`
   ============================================================ */
macro
  = '`' name:macro_name_chars args:macro_args? '`'
    {
      return {
        type: 'Macro',
        name: name,
        args: args || []
      };
    }

macro_name_chars
  = chars:[^`(]+ { return chars.join('').trim(); }

macro_args
  = '(' first:macro_arg rest:(',' _* arg:macro_arg { return arg; })* ')'
    { return [first].concat(rest); }

macro_arg
  = _* chars:[^,)`]+ { return chars.join('').trim(); }

/* ============================================================
   Time constraints: earliest=X, latest=X
   ============================================================ */
time_constraint
  = param:('earliest'i / 'latest'i) '=' value:time_value
    {
      return {
        type: 'TimeConstraint',
        param: param.toLowerCase(),
        value: value
      };
    }

time_value
  = chars:[^ \t\r\n\f|()]+ { return chars.join(''); }

/* ============================================================
   IN comparison: field IN (val1, val2, ...)
   ============================================================ */
in_comparison
  = '"' field:double_string_char* '"' _* 'IN'i _* '(' _* values:in_value_list _* ')'
    {
      return {
        type: 'InComparison',
        field: field.join(''),
        values: values
      };
    }
  / field:search_field _* 'IN'i _* '(' _* values:in_value_list _* ')'
    {
      return {
        type: 'InComparison',
        field: field,
        values: values
      };
    }

in_value_list
  = first:in_value rest:((_* ',' _* / _+) v:in_value { return v; })*
    { return [first].concat(rest); }

in_value
  = '"' chars:double_string_char* '"' { return chars.join(''); }
  / "'" chars:single_string_char* "'" { return chars.join(''); }
  / '\\"' chars:escaped_quote_inner* '\\"' { return chars.join(''); }
  / chars:[^,)"' \t]+ { return chars.join(''); }

/* ============================================================
   Field comparisons: field=value, field!=value, field>=value, etc.
   ============================================================ */
comparison
  = '"' field:double_string_char* '"' _* op:comparison_op _* value:search_value
    {
      return {
        type: 'Comparison',
        field: field.join(''),
        operator: op,
        value: value
      };
    }
  / field:search_field _* op:comparison_op _* value:search_value
    {
      return {
        type: 'Comparison',
        field: field,
        operator: op,
        value: value
      };
    }

search_field
  = first:[a-zA-Z_] rest:[a-zA-Z0-9_.\-:{}]*
    { return first + rest.join(''); }

comparison_op
  = '!=' { return '!='; }
  / '>=' { return '>='; }
  / '<=' { return '<='; }
  / '==' { return '=='; }
  / '>' { return '>'; }
  / '<' { return '<'; }
  / '=' { return '='; }

search_value
  // A bare $tok$ in value position is a dashboard variable, emitted as {{tok}}.
  // The !search_value_char lookahead requires the token to be the COMPLETE value:
  // `field=$tok$suffix` backtracks to the literal path (embedded tokens stay
  // quoted-literal — out of scope), so only a standalone $tok$ becomes a node.
  = tv:template_variable !search_value_char { return tv; }
  / '"' chars:double_string_char* '"' { return chars.join(''); }
  / "'" chars:single_string_char* "'" { return chars.join(''); }
  / '\\"' chars:escaped_quote_inner* '\\"' { return chars.join(''); }
  / chars:search_value_char+ { return chars.join(''); }

search_value_char
  = [^ \t\r\n\f|()"]

escaped_quote_inner
  = '\\' !'"' ch:. { return '\\' + ch; }
  / !('\\"') ch:. { return ch; }

/* ============================================================
   Bare keywords (unqualified search terms)
   ============================================================ */
bare_keyword
  // The JSON-fragment idiom `"key":"value"` / `"key":123`: quoted pieces joined by
  // ':' with no whitespace. Kept as ONE term (fragment: true) so it can be
  // reported by name, instead of failing the whole search at the ':'.
  = text:$('"' double_string_char* '"' (':' ('"' double_string_char* '"' / keyword_char+))+)
    { return { type: 'BareKeyword', value: text, quoted: true, fragment: true }; }
  / '"' chars:double_string_char* '"'
    { return { type: 'BareKeyword', value: chars.join(''), quoted: true }; }
  / "'" chars:single_string_char* "'"
    { return { type: 'BareKeyword', value: chars.join(''), quoted: true }; }
  / chars:keyword_char+
    { return { type: 'BareKeyword', value: chars.join(''), quoted: false }; }

// '!' is an ordinary term character (`!!Title!!!`) except where it starts the
// `!=` operator — search has no `!` NOT operator.
keyword_char
  = '\\' ch:. { return ch; }
  / '!' !'=' { return '!'; }
  / [^ \t\r\n\f|()=!<>"`']

/* String char rules. Splunk's only real escape sequences are \\, \", and
   \' — quote-escapes plus literal-backslash. Every other backslash sequence
   (\d, \s, \w, \(, \., \n, \t, \r, ...) passes through verbatim with the
   backslash preserved. This matches the canonical SPL example
   `match(field, "^\d{1,3}\.\d{1,3}...")` working with single backslashes,
   and the docs note (TextFunctions, replace()) that eval performs only one
   level of escaping before passing strings to PCRE — meaning \\ becomes \
   but \n stays as the two characters \ + n. NRQL accepts \n as newline
   either way; the difference matters for regex semantics. */
double_string_char
  = '\\\\' { return '\\'; }
  / '\\"' { return '"'; }
  / '\\\'' { return '\''; }
  / '\\' ch:. { return '\\' + ch; }
  / [^"\\]

single_string_char
  = '\\\\' { return '\\'; }
  / '\\"' { return '"'; }
  / '\\\'' { return '\''; }
  / '\\' ch:. { return '\\' + ch; }
  / [^'\\]

/* ============================================================
   Whitespace
   ============================================================ */
_ "whitespace"
  = '```' [^`]* '```'
  / [ \t\r\n\f]
